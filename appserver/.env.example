# appserver 配置（复制为 .env 后按需修改）
# cd appserver && copy .env.example .env && go run ./cmd/appserver

# --- 数据库（docker compose 用）---
WEB_DB_USER=ihope_web
WEB_DB_PASSWORD=webdevpassword
WEB_DB_NAME=ihope_web
WEB_DB_PORT=5434

DATABASE_URL=postgres://ihope_web:webdevpassword@127.0.0.1:5434/ihope_web?sslmode=disable
HTTP_ADDR=:8090

# --- Web 前端 ---
CORS_ORIGIN=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173

# --- JWT / 管理 ---
JWT_SECRET=dev-change-me-jwt-secret-min-32-chars!!
JWT_ACCESS_TTL_MIN=60
ADMIN_TOKEN=dev-admin-token-change-me
FELLOWSHIP_CODE=盼望之地
# 启动时若库中无此团契码则自动创建；注册校验改为查库中任意团契码（管理页可增改）

# MESSAGE_ENCRYPTION_KEY=   # openssl rand -base64 32；生产必填

# --- 邮件 ---
# log = 只打控制台；smtp = 真实发信
MAIL_DRIVER=log
MAIL_FROM=noreply@localhost
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_VERIFY_TTL_MIN=1440

# --- QQ 机器人（开放平台 q.qq.com）---
# 回调：{APP_PUBLIC_URL}/api/webhooks/qq
QQ_BOT_ENABLED=false
QQ_BOT_APP_ID=
QQ_BOT_APP_SECRET=
QQ_WEBHOOK_PATH=/api/webhooks/qq
QQ_BOT_ADD_HINT=请在 QQ 中添加 IHope 机器人，并将绑定码发送给它
QQ_DOORBELL_COOLDOWN_SEC=600
# 金句文件（可选，每行一条）；本地可指 ../deploy/quotes/quotes.example.txt
QQ_QUOTES_FILE_PATH=
# 可选 TURN（逗号分隔）；未配置时仅用公共 STUN，跨网可能连不上
# CALL_TURN_URLS=turn:turn.example.com:3478
# CALL_TURN_USERNAME=
# CALL_TURN_CREDENTIAL=

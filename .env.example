# =============================================================================
# IHope 环境变量模板 → 复制到 deploy/.env
#   cd deploy && copy ..\.env.example .env
# =============================================================================

# --- 数据库 ---
DB_PASSWORD=devpassword
POSTGRES_USER=ihope
POSTGRES_DB=ihope
DB_HOST=127.0.0.1
DB_PORT=5432

# --- JWT ---
JWT_SECRET=change_me_jwt_secret_at_least_32_chars
JWT_ACCESS_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# --- 应用 ---
# 对外 URL（邮件链接、App 更新、QQ 图卡公网拉取）
APP_PUBLIC_URL=http://localhost:8080
SERVER_PORT=8080
# 开发可用 *；Tunnel/生产填公网域名
CORS_ALLOW_ORIGIN=*

# --- 限流 / Token ---
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SEC=60
RESET_TOKEN_TTL_MIN=30
EMAIL_VERIFY_TTL_MIN=1440

# --- 邮件 ---
# log = 只打到后端日志；smtp = 真实发信（需填 SMTP_*）
MAIL_DRIVER=log
MAIL_FROM=noreply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- QQ 机器人（官方开放平台 q.qq.com）---
# 回调填：{APP_PUBLIC_URL}/api/webhooks/qq（端口限 80/443/8080/8443）
QQ_BOT_ENABLED=true
QQ_BOT_APP_ID=
QQ_BOT_APP_SECRET=
QQ_WEBHOOK_PATH=/api/webhooks/qq
QQ_POETRY_API_URL=https://v1.hitokoto.cn/?c=i
QQ_NEWS_60S_API_URL=https://60s.viki.moe/v2/60s?encoding=image-proxy
QQ_POETRY_FONT_PATH=/opt/ihope/fonts/MSYH.TTC
QQ_POETRY_FONT_HOST_DIR=./fonts
# 金句文案库：每行一条，UTF-8 文本；# 开头为注释
QQ_QUOTES_FILE_PATH=/opt/ihope/quotes/quotes.txt
QQ_QUOTES_HOST_DIR=./quotes
QQ_DAILY_POETRY_HHMM=08:00
QQ_DAILY_QUOTES_HHMM=08:02
QQ_DAILY_NEWS_HHMM=08:05
QQ_DOORBELL_COOLDOWN_SEC=600
QQ_BOT_ADD_HINT=请在 QQ 中添加 IHope 官方机器人，并将绑定码发送给它
# 启动时通过 OpenAPI 同步单聊底部菜单与「/」指令面板（见 bot.q.qq.com 文档）
QQ_BOT_SYNC_MENU_PANEL=true

# --- 海外 FCM HTTP v1（可选；国内包用 QQ 门铃即可）---
# Firebase → 服务账号 → 生成私钥 JSON，放到 deploy/ 目录（勿提交 Git）
FCM_CREDENTIALS_FILE=
FCM_PROJECT_ID=
FCM_CREDENTIALS_HOST_FILE=./fcm-placeholder.json
FCM_CREDENTIALS_JSON=
FCM_SERVER_KEY=

# --- 上传 / 客户端可见 ---
MAX_ENCRYPTED_FILE_BYTES=314572800
CLOUD_DRIVE_URL=https://1t1.org
SERVER_VERSION=2026-08-23 0.1.8 version
APP_DOWNLOAD_URL=
DRAIN_SECONDS=15

# --- 开发无感升级（devproxy + upgrade-dev.ps1）---
PUBLIC_PORT=8080
BACKEND_PORT_A=8081
BACKEND_PORT_B=8082

# --- 管理页（与 App 账号无关）---
ADMIN_SECRET=change_me_admin_secret_at_least_32_chars
ADMIN_WEB_DIR=
